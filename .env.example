# SQLite database URL (default for dev; switch to Postgres for production)
DATABASE_URL=file:./db/custom.db

# Vercel Cron secret — required for /api/cron/refresh endpoint
# Generate a random string and set this both here and in your cron provider
CRON_SECRET=replace-with-a-random-string

# Optional: Google Places API key & Place ID can be set via env vars
# instead of via the admin UI. If set, the cron job uses them directly.
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=
