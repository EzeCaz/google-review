{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/refresh?token=REPLACE_WITH_CRON_SECRET",
      "schedule": "0 3 * * *"
    }
  ],
  "functions": {
    "src/app/api/reviews/public/route.ts": {
      "maxDuration": 10
    },
    "src/app/api/cron/refresh/route.ts": {
      "maxDuration": 60
    }
  }
}
